# Environment Configuration for SousSpeed
# Copy this to .env and update with your actual values

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=souspeed-app
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_SENDER_ID=your-sender-id-here  
FIREBASE_APP_ID=your-app-id-here
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Stripe Configuration (Use your test keys for development)
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef...
STRIPE_SECRET_KEY=sk_test_51234567890abcdef...
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef...
STRIPE_PRO_CHEF_PRICE_ID=price_1234567890abcdef

# Database Configuration
DATABASE_PATH=souspeed.db

# Email Configuration (for future email verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Configuration
APP_NAME=SousSpeed
APP_VERSION=1.0.0
APP_URL=http://localhost:8080
